# =============================================================================
#  AS Video Studio (fork OpenRouter) — variables de entorno
#  Copia a .env y rellena lo que proceda.
# =============================================================================

# ---- LLM (sustituye al CLI de Claude Code; ya NO hace falta suscripcion) ----
OPENROUTER_API_KEY=tu-openrouter-api-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Modelo por defecto si el repo pide "opus" (su defecto). Cambia a gusto/coste.
#   barato:  google/gemini-3.7-flash   (~$0.19/$0.94 por 1M)
#   barato2: deepseek/deepseek-v4.1-flash (~$0.04/$0.49 por 1M)
#   gratis:  openrouter/free  (rota modelos gratis; rate-limit ~20/min, 200/dia)
ASVS_LLM_MODEL=google/gemini-3.7-flash
OPENROUTER_HTTP_REFERER=https://github.com/NeverBlink/as-video-studio
OPENROUTER_SITE_NAME=AS Video Studio

# ---- IMAGEN: elige proveedor con ASVS_IMAGEN_MOTOR ----
#   openrouter -> OpenRouter (cobra por imagen; modelo en ASVS_IMAGEN_MODEL)
#   openai     -> OpenAI gpt-image-2 (requiere OPENAI_API_KEY y acepta referencias)
ASVS_IMAGEN_MOTOR=openrouter
ASVS_IMAGEN_MODEL=bytedance-seed/seedream-4.5   # ~$0.05 ; o openai/gpt-image-2 (~$0.035 low)
ASVS_IMAGEN_COSTE=0.05                          # estimacion para el medidor de la UI
# Solo si ASVS_IMAGEN_MOTOR=openai:
# OPENAI_API_KEY=sk-...

# ---- VOZ: elige proveedor con ASVS_VOZ_MOTOR ----
#   edgetts   -> Edge TTS, 100% gratis, sin clave (defecto)
#   cartesia  -> Cartesia (plan gratis; requiere CARTESIA_API_KEY en Configuracion)
ASVS_VOZ_MOTOR=edgetts
# Solo si ASVS_VOZ_MOTOR=cartesia:
# CARTESIA_API_KEY=...

# ---- Rutas de datos (aislamiento por proceso) ----
ESTUDIO_PROYECTOS=/data/proyectos
ESTUDIO_PRESETS=/data/presets
ESTUDIO_BANCO=/data/banco
ESTUDIO_BANCO_PRESETS=/data/banco_presets
ESTUDIO_SECRETOS=/data/secretos
ESTUDIO_AJUSTES=/data/ajustes
ESTUDIO_RECETAS=/data/recetas
ESTUDIO_TARIFAS=/data/tarifas
ESTUDIO_ESTADISTICAS=/data/estadisticas
ESTUDIO_COSTE_GLOBAL=/data/coste_global
ESTUDIO_BITACORA_GLOBAL=/data/bitacora
ESTUDIO_MOTORES=/app/motores
ESTUDIO_FUENTES=/usr/local/share/fonts/estudio

# ---- Navegador para rasterizar planos ----
# ESTUDIO_EDGE=/usr/bin/microsoft-edge

# ---- Render: cuantos planos a la vez (baja si te falta RAM) ----
ESTUDIO_LOTES=2

# ---- Sin salida a APIs de pago (solo para pruebas) ----
# ESTUDIO_SIMULAR=0
